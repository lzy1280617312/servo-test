<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:orientation="vertical"
              android:padding="20dp"
              android:gravity="center" android:id="@+id/Helloworld">

    <!-- IP输入框 -->
    <EditText
            android:id="@+id/et_ip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="树莓派IP地址（如192.168.1.100）"
            android:text="192.168.0.201"
            android:inputType="textUri"/>

    <!-- 端口输入框 -->
    <EditText
            android:id="@+id/et_port"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="端口号"
            android:text="8888"
            android:inputType="number"
            android:layout_marginTop="10dp"/>

    <!-- 连接/断开按钮 -->
    <Button
            android:id="@+id/btn_connect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="连接树莓派"
            android:layout_marginTop="10dp" android:backgroundTint="#00BCD4"/>

    <!-- 角度输入框 -->
    <EditText
            android:id="@+id/et_angle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="输入舵机角度（0-180）"
            android:text="90.0"
            android:inputType="text"
            android:layout_marginTop="20dp" android:baselineAligned="false"/>

    <!-- 发送按钮 -->
    <Button
            android:id="@+id/btn_send"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="发送指令"
            android:layout_marginTop="10dp" android:backgroundTint="#00BCD4"/>
    <TextView
            android:id="@+id/tv_status"
            android:layout_width="match_parent"
            android:layout_height="41dp"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="未连接"
            android:textSize="16sp"/>

    <!-- 状态显示标签 -->

</LinearLayout>